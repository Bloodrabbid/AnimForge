згиба, которая пульсирует (0 — статично, 1 — от 0 до 2·angle)"},"period":{"type":"number","default":3,"min":0.2,"max":10,"unit":"с","help":"период пульсации"},"phase":{"type":"number","default":0,"min":0,"max":360,"unit":"°","help":"сдвиг пульсации (чтобы разнести несколько слоёв или существ)"}},"main":["angle","period","pulse"],"help":"Изгиб цепочки: угол распределён по костям с ростом к кончику, может пульсировать. Загиб щупальца, поджатый хвост, дыхание (маленький пульсирующий изгиб спины), сжатие перед прыжком."},"compass-step":{"params":{"role":{"type":"enum","default":"leg_left","options":["leg_left","leg_right","core"],"help":"чем управляет слой"},"plane":{"type":"enum","default":"vertical","options":["lateral","vertical","roll"],"help":"ось поворота: для ноги vertical (вперёд-назад), для корпуса lateral (крен вбок у вертикальной спины)"},"period":{"type":"number","default":1.2,"min":0.3,"max":4,"unit":"с","help":"цикл из двух шагов; в Biped темп задаёт игрок стиком — в коде числа нет"},"reach":{"type":"number","default":90,"min":0,"max":120,"unit":"°","help":"мах шагающей ноги (Biped: 90, лёд 108, хват 120)"},"support":{"type":"number","default":36,"min":0,"max":60,"unit":"°","help":"отклонение опорной ноги назад (Biped: 36, старая модель 45)"},"coreRoll":{"type":"number","default":36,"min":-45,"max":45,"unit":"°","help":"крен корпуса над опорной ногой; минус — в другую сторону"},"openTime":{"type":"number","default":0.28,"min":0.03,"max":1,"unit":"с","help":"за сколько поза шага раскрывается полностью (Biped: 0.28, лёд 0.083)"},"gain":{"type":"number","default":1,"min":0,"max":1,"help":"какую долю целевых углов тело реально проходит: в Biped 90°/36° — цели PD-пружин с ограниченной силой, под гравитацией они не достигаются"},"springHz":{"type":"number","default":1.6,"min":0.5,"max":7,"unit":"Гц","help":"собственная частота сглаживающей пружины (Biped ≈ 1.6 свободно, 3.9 при кручении стика — оценка)"},"damping":{"type":"number","default":0.47,"min":0.1,"max":2,"help":"ζ пружины: < 1 — с перелётом, 1 — критическое"}},"main":["period","reach","coreRoll"],"help":"Шаг циркулем (Biped): шагающая нога раскрывается на reach за openTime, опорная отклоняется на −support, корпус кренится на coreRoll над опорной ногой. Ноги в противофазе. Резкие смены позы сглаживает пружина (springHz, damping) — в игре это делают физические PD-пружины. Один слой на цепочку: role = leg_left | leg_right | core. Ноги — вертикальные цепочки вниз, plane=vertical (мах вперёд-назад); корпус — plane=lateral (крен вбок)."},"waddle-walk":{"params":{"role":{"type":"enum","default":"pelvis","options":["pelvis","chest","head","arm_l","arm_r","leg_l","leg_r"],"help":"какую часть тела крутит слой (первая кость цепочки; у ног и рук — две кости)"},"period":{"type":"number","default":0.479,"min":0.3,"max":2,"unit":"с","help":"цикл из двух шагов (Tools Up!: 0.479, с ношей 0.5–0.6; TLJ: ходьба 1.3–1.37, бег 0.73)"},"pelvisYaw":{"type":"number","default":32,"min":0,"max":45,"unit":"°","help":"рыскание таза, один раз за цикл (±32.7)"},"chestCounter":{"type":"number","default":0.49,"min":0,"max":2,"help":"рыскание плеч — доля от таза (Tools Up! 16.1 / 32.7; бег Геральта 1.97)"},"chestPhase":{"type":"number","default":180,"min":-180,"max":360,"unit":"°","help":"фаза плеч к тазу: 180 — строго против (Tools Up!), Геральт −132 в шаге и −9 в боевом шаге"},"headYaw":{"type":"number","default":6,"min":0,"max":15,"unit":"°","help":"остаток рыскания головы после стабилизации (±5.9)"},"pelvisRoll":{"type":"number","default":10,"min":0,"max":25,"unit":"°","help":"крен таза «вразвалку» (±10.0)"},"chestRoll":{"type":"number","default":14,"min":0,"max":25,"unit":"°","help":"крен груди (±14.3)"},"headRoll":{"type":"number","default":7,"min":0,"max":25,"unit":"°","help":"крен головы (±6.9)"},"rollPhase":{"type":"number","default":80,"min":0,"max":180,"unit":"°","help":"фаза крена относительно рыскания (таз 80, грудь 78)"},"headLag":{"type":"number","default":54,"min":0,"max":120,"unit":"°","help":"отставание крена головы по фазе (≈0.07 с)"},"bob":{"type":"number","default":0.248,"min":0,"max":0.4,"help":"подскок таза — доля его высоты (24.8 %; спокойные 14.5–21 %)"},"armSwing":{"type":"number","default":30,"min":0,"max":60,"unit":"°","help":"маятник рук, в противофазе ногам (UpperArm ±30)"},"armLag":{"type":"number","default":0,"min":0,"max":90,"unit":"°","help":"руки отстают от шага по фазе — оверлап; нужен, когда мах маленький (колобок), иначе руки «приклеены»"},"legSwing":{"type":"number","default":30,"min":0,"max":60,"unit":"°","help":"мах бедра (Witcher: шаг ±24.7, бег ±31.8; TLJ ±14–17)"},"knee":{"type":"number","default":45,"min":0,"max":120,"unit":"°","help":"подгиб колена в переносе ноги (на глаз)"},"chestBow":{"type":"number","default":0,"min":0,"max":30,"unit":"°","help":"поклон груди на каждом шаге, 2-я гармоника (голем Witcher ±15; Tools Up! 0)"}},"main":["period","pelvisRoll","bob","armSwing","legSwing"],"help":"Мультяшная ходьба вразвалку (Tools Up!): таз рыщет и подпрыгивает, плечи в противофазе, голова стабилизирована, руки маятником, ноги — простой мах с подгибом колена. Один слой на роль. Повороты — в осях тела (yaw, bank, pitch), поэтому рецепт одинаков для любого рига; руки в T-позе сначала опусти project.align (rig.detect делает это сам)."},"blink":{"params":{"interval":{"type":"number","default":1.8,"min":0.5,"max":6,"unit":"с","help":"период морганий"},"close":{"type":"number","default":0.067,"min":0.03,"max":0.15,"unit":"с","help":"закрыть (2 кадра)"},"hold":{"type":"number","default":0.083,"min":0,"max":0.2,"unit":"с","help":"держать закрытым"},"open":{"type":"number","default":0.05,"min":0.03,"max":0.25,"unit":"с","help":"открыть (Tools Up! 0.05; у Геральта медленнее закрытия — 0.167)"},"minY":{"type":"number","default":0.3,"min":0,"max":0.6,"help":"масштаб по вертикали в закрытом глазу (медиана 0.32)"},"widenX":{"type":"number","default":1.2,"min":1,"max":1.5,"help":"расширение вбок в закрытом глазу (1.21)"},"overshoot":{"type":"number","default":1.17,"min":1,"max":1.3,"help":"перелёт по вертикали при открытии"},"settle":{"type":"number","default":0.1,"min":0.02,"max":0.4,"unit":"с","help":"успокоение после перелёта (на глаз)"}},"main":["interval","close","open"],"help":"Моргание масштабом кости глаза (Tools Up!): сплющить по вертикали и чуть расширить, подержать, открыть с перелётом. Цикл = interval; моргание в начале цикла."},"jiggle":{"params":{"hz":{"type":"number","default":1.6,"min":0.3,"max":8,"unit":"Гц","help":"собственная частота (ухо 1.6, волосы 2.4, желе-голова 4.2)"},"damping":{"type":"number","default":0.31,"min":0.05,"max":1.5,"help":"ζ: 0.2 — болтается долго, 1 — без перелёта"},"inert":{"type":"number","default":0.5,"min":0,"max":1,"help":"доля движения родителя, которую кость «берёт с собой» (меньше раскачки)"},"gain":{"type":"number","default":1,"min":0,"max":3,"help":"усиление раскачки (1 — физически)"},"length":{"type":"number","default":1,"min":0.2,"max":5,"help":"множитель длины маятника: длиннее — сильнее отзыв на повороты, слабее на толчки"}},"main":["hz","damping","gain"],"help":"Вторичная динамика (как DynamicBone): цепочка — маятник с пружиной, её раскачивают ускорения и повороты родителя из остальных слоёв. Уши, усы, волосы, хвосты, шапки. Считается симуляцией по запечённому движению, цикл замыкается."},"melee-strike":{"params":{"role":{"type":"enum","default":"arm","options":["arm","core","pelvis"],"help":"что двигает слой"},"start":{"type":"number","default":0,"min":0,"max":10,"unit":"с","help":"когда начать (несколько ударов в одном клипе)"},"hits":{"type":"number","default":1,"min":1,"max":6,"help":"ударов в звене серии (Witcher: 2 → 4 → 5 → 4 по уровням)"},"firstHit":{"type":"number","default":0.685,"min":0.19,"max":2.2,"unit":"с","help":"от начала до первого удара — «телеграф» (собаки 0.31, меч 0.57, двуручник 1.01, голем 1.20; Геральт 0.21–0.60)"},"strike":{"type":"number","default":0.3,"min":0.05,"max":0.6,"unit":"с","help":"разгон взмаха до пика скорости (медиана 169 ударов 0.30)"},"follow":{"type":"number","default":0.3,"min":0.05,"max":0.8,"unit":"с","help":"торможение после пика — доводка (медианы стилей 0.25–0.52)"},"interval":{"type":"number","default":0.47,"min":0.15,"max":0.8,"unit":"с","help":"между ударами серии (быстрый стиль 0.29, сильный 0.47)"},"hitLag":{"type":"number","default":0.053,"min":-0.02,"max":0.15,"unit":"с","help":"контакт после пика скорости (Witcher 0.053; Tools Up! молоток 0.035)"},"recover":{"type":"number","default":0.4,"min":0.05,"max":1.5,"unit":"с","help":"возврат в стойку (на глаз)"},"tail":{"type":"number","default":0.9,"min":0,"max":2,"unit":"с","help":"окно на следующий ввод после возврата (сталь 0.9, серебро 1.1–1.3)"},"tempo":{"type":"number","default":1,"min":0.5,"max":2.5,"help":"ускорение всего звена — так Witcher делает серию быстрее тем же мокапом (×1.37…1.92)"},"windupAngle":{"type":"number","default":110,"min":0,"max":170,"unit":"°","help":"подъём руки в замахе (на глаз: в играх измерен подъём кисти, не угол)"},"followAngle":{"type":"number","default":20,"min":-120,"max":120,"unit":"°","help":"где рука заканчивает взмах: 20 — рубящий удар закончен впереди-внизу, −60 — рука уходит за спину (на глаз)"},"elbow":{"type":"number","default":60,"min":0,"max":140,"unit":"°","help":"сгиб локтя в замахе; к доводке рука выпрямляется (на глаз)"},"plane":{"type":"enum","default":"vertical","options":["vertical","lateral"],"help":"плоскость маха руки: vertical — рубящий сверху (вперёд-вверх), lateral — вбок"},"side":{"type":"enum","default":"r","options":["l","r"],"help":"какой рукой (для бокового маха — в какую сторону)"},"coreTwist":{"type":"number","default":25,"min":0,"max":60,"unit":"°","help":"кручение корпуса за рукой (на глаз)"},"coreLean":{"type":"number","default":10,"min":0,"max":40,"unit":"°","help":"наклон корпуса за рукой (на глаз)"},"crouch":{"type":"number","default":0.1,"min":0,"max":0.4,"help":"присед на замахе — доля высоты таза (на глаз)"},"settle":{"type":"number","default":0.22,"min":0,"max":0.4,"help":"оседание после удара — доля высоты таза (Tools Up! молоток −0.10 при тазе 0.46)"},"trailLead":{"type":"number","default":0.13,"min":0,"max":0.3,"unit":"с","help":"шлейф клинка включается до контакта (0.09–0.22)"},"trailLag":{"type":"number","default":0.05,"min":0,"max":0.15,"unit":"с","help":"и гаснет после (0.01–0.12)"},"whooshLead":{"type":"number","default":0.115,"min":0,"max":0.3,"unit":"с","help":"звук взмаха до контакта (n = 337, 0.045–0.29)"},"effortLead":{"type":"number","default":0.17,"min":0,"max":0.4,"unit":"с","help":"выдох/крик усилия до контакта (n = 193)"}},"main":["firstHit","strike","windupAngle","coreTwist","crouch"],"help":"Удар или серия ударов (Witcher + Tools Up!): замах → взмах с пиком скорости в контакте → доводка → возврат → окно на следующий ввод. Один слой на роль: arm — цепочка плечо→локоть (мах vertical, локоть сгибается в крайних точках), core — кручение и наклон корпуса за рукой, pelvis — присед на замахе и оседание после удара. События: hit, trail_on/off, whoosh, effort, window_open/close."},"charge-release":{"params":{"role":{"type":"enum","default":"arm","options":["arm","core","pelvis"],"help":"что двигает слой"},"windup":{"type":"number","default":1.7,"min":0.3,"max":3,"unit":"с","help":"замах заряда (1hS_powpre 1.70)"},"hold":{"type":"number","default":0.8,"min":0,"max":5,"unit":"с","help":"удержание; в игре — петля 0.80 с, пока держат кнопку"},"holdPeriod":{"type":"number","default":0.8,"min":0.2,"max":2,"unit":"с","help":"период пружинки в удержании (длина петли)"},"holdBob":{"type":"number","default":0.058,"min":0,"max":0.15,"help":"пружинка корня в удержании — доля высоты таза (5.4 см при 0.93)"},"release":{"type":"number","default":1.9,"min":0.4,"max":3,"unit":"с","help":"выпуск (1hS_pow_1 1.90)"},"hit1":{"type":"number","default":0.4,"min":0.1,"max":1.5,"unit":"с","help":"первый удар от начала выпуска (0.40)"},"hit2":{"type":"number","default":1.05,"min":0.2,"max":2.5,"unit":"с","help":"второй удар (1.05)"},"windupAngle":{"type":"number","default":140,"min":0,"max":175,"unit":"°","help":"замах заряда — шире обычного (на глаз)"},"followAngle":{"type":"number","default":10,"min":-120,"max":120,"unit":"°","help":"где рука заканчивает первый взмах (на глаз)"},"elbow":{"type":"number","default":70,"min":0,"max":140,"unit":"°","help":"сгиб локтя в замахе (на глаз)"},"coreTwist":{"type":"number","default":35,"min":0,"max":60,"unit":"°","help":"кручение корпуса (на глаз)"},"crouch":{"type":"number","default":0.15,"min":0,"max":0.4,"help":"присед в заряде — доля высоты таза (на глаз)"}},"main":["windup","hold","release","windupAngle"],"help":"Силовая атака (Witcher): долгий замах → удержание с пружинящим корнем (петля) → выпуск двумя ударами → возврат. Роли как у melee-strike. События: charge_start, charge_full, hit ×2, window_open."},"quadruped-gait":{"params":{"role":{"type":"enum","default":"leg_fl","options":["pelvis","spine","neck","leg_fl","leg_fr","leg_hl","leg_hr"],"help":"какую часть крутит слой: таз, спина, шея или лапа (fl — передняя левая, hr — задняя правая)"},"gait":{"type":"enum","default":"walk","options":["walk","run"],"help":"набор кривых: walk — шаг собаки (M_walk), run — галоп (M_run)"},"period":{"type":"number","default":0.933,"min":0.25,"max":3,"unit":"с","help":"цикл: каждая лапа шагает один раз (собака: шаг 0.933, галоп 0.5)"},"offsetFR":{"type":"number","default":0.496,"min":0,"max":1,"help":"фаза передней правой от передней левой, доля цикла (шаг 0.496, галоп 0.333, рысь 0.5)"},"offsetHL":{"type":"number","default":0.463,"min":0,"max":1,"help":"фаза задней левой (шаг 0.463, галоп 0.733, рысь 0.5, иноходь 0)"},"offsetHR":{"type":"number","default":0.892,"min":0,"max":1,"help":"фаза задней правой (шаг 0.892, галоп 0.933, рысь 0, иноходь 0.5)"},"legs":{"type":"number","default":1,"min":0,"max":2,"help":"размах суставов лап — доля от собаки"},"body":{"type":"number","default":1,"min":0,"max":3,"help":"качание корпуса и шеи — доля от собаки (шаг: спина ±1.1°, шея ±3°; галоп: корпус ±11°, шея ±8.5°)"},"bob":{"type":"number","default":1,"min":0,"max":5,"help":"подскок таза — доля от собаки (шаг 1.3 % высоты таза, галоп 7.4 %)"}},"main":["period","legs","body","bob"],"help":"Походка четвероногого по собаке Witcher: у каждой лапы свои кривые плеча/бедра, локтя/колена, пясти/плюсны и пальцев (вынос быстрый, опора ≈70 % цикла), лапы сдвинуты по фазе (шаг — почти диагональные пары, галоп — задние, потом передние). Корпус качается носом вверх-вниз и изгибается вбок, шея — своё минус корпус, таз подскакивает. Цепочки — как у rig.detect для четвероногих: передние лапы arm_l/arm_r, задние leg_l/leg_r. Хвост не анимирован и в Witcher — повесь на него jiggle."},"multileg-gait":{"params":{"role":{"type":"enum","default":"leg_l0","options":["leg_l0","leg_r0","leg_l1","leg_r1","leg_l2","leg_r2","leg_l3","leg_r3","leg_l4","leg_r4","leg_l5","leg_r5","leg_l6","leg_r6","leg_l7","leg_r7","leg_l8","leg_r8","leg_l9","leg_r9","leg_l10","leg_r10","leg_l11","leg_r11","leg_l12","leg_r12","leg_l13","leg_r13","leg_l14","leg_r14","leg_l15","leg_r15","leg_l16","leg_r16","leg_l17","leg_r17","leg_l18","leg_r18","leg_l19","leg_r19","leg_l20","leg_r20","leg_l21","leg_r21","leg_l22","leg_r22","leg_l23","leg_r23","spine","pelvis","chest"],"help":"нога (leg_l0 — передняя левая), spine, pelvis или chest"},"period":{"type":"number","default":0.6,"min":0.1,"max":4,"unit":"с","help":"цикл одной ноги"},"duty":{"type":"number","default":0.5,"min":0.2,"max":0.9,"help":"доля опоры в цикле (трипод 0.5, медленная волна 0.6–0.8)"},"lag":{"type":"number","default":0.5,"min":-1,"max":1,"help":"сдвиг фазы между соседними парами, доля цикла (трипод 0.5; волна сколопендры 0.1–0.2)"},"side":{"type":"number","default":0.5,"min":0,"max":1,"help":"сдвиг правой стороны от левой (0.5 — в противофазе)"},"swing":{"type":"number","default":20,"min":0,"max":60,"unit":"°","help":"размах бедра вперёд-назад (±)"},"lift":{"type":"number","default":20,"min":0,"max":60,"unit":"°","help":"подъём бедра в переносе"},"fold":{"type":"number","default":15,"min":0,"max":60,"unit":"°","help":"складывание голени в переносе"},"bodyWave":{"type":"number","default":0,"min":0,"max":30,"unit":"°","help":"волна тела вбок на кость spine (сколопендра)"},"waveLag":{"type":"number","default":0.1,"min":-1,"max":1,"help":"сдвиг фазы волны тела на кость"},"pelvisYaw":{"type":"number","default":0,"min":0,"max":30,"unit":"°","help":"рыскание таза раз за цикл (кикимора ±9.8)"},"chestRoll":{"type":"number","default":0,"min":0,"max":30,"unit":"°","help":"крен груди раз за цикл (кикимора ±17.3)"},"bob":{"type":"number","default":0,"min":0,"max":0.2,"help":"подскок таза дважды за цикл — доля высоты (кикимора 0.066 / 1.86 = 3.5 %)"}},"main":["period","swing","lift","bob"],"help":"Походка многоногого (насекомое, паук, сколопендра): каждая нога — опора (стопа равномерно уходит назад) и перенос (вынос вперёд с подъёмом, голень складывается). Ноги сдвинуты по фазе: lag — сдвиг между соседними парами (волна от хвоста к голове), side — между левой и правой. У шести ног lag 0.5 и side 0.5 дают трипод. Цепочки — из rig.detect: leg_l0, leg_r0 (передняя пара), leg_l1… и spine (волна тела, у сколопендры)."},"wing-flap":{"params":{"role":{"type":"enum","default":"wing_l","options":["wing_l","wing_r","body","tail","leg_l","leg_r"],"help":"крыло, корпус (таз), хвост или нога"},"period":{"type":"number","default":0.35,"min":0.05,"max":6,"unit":"с","help":"один взмах (птица 0.2–0.5, ласт черепахи ~4)"},"amp":{"type":"number","default":45,"min":0,"max":90,"unit":"°","help":"размах: от середины до верха и до низа"},"mean":{"type":"number","default":5,"min":-45,"max":45,"unit":"°","help":"середина взмаха: + — крылья выше горизонта"},"down":{"type":"number","default":0.55,"min":0.3,"max":0.8,"help":"доля цикла на рабочий ход вниз"},"lag":{"type":"number","default":0.08,"min":0,"max":0.3,"help":"отставание фазы на кость к кончику, доля цикла"},"fold":{"type":